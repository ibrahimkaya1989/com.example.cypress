{
  "name": "com.example.cypress",
  "version": "2026.10.1",
  "private": true,
  "description": "Cypress end-to-end and API test suite",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:headed": "cypress run --headed --browser electron",
    "test:api": "cypress run --spec \"cypress/integration/api_tests/**/*.spec.js\"",
    "test:softpos": "cypress run --spec \"cypress/integration/softpos/**/*.spec.js\"",
    "report": "marge cypress/reports/report.json -o cypress/reports"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "cypress": "^16.1.1",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
